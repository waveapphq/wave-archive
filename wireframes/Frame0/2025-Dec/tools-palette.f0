ons\"))\n  (. canvas :strokeRoundRect (- l g) (- t g) (+ r g) (+ b g) c seed)\n  (if buttons\n    (do \n      (. canvas :ellipse (+ l 14) (- yc 5) (+ l 24) (+ yc 5) (+ seed 2))\n      (. canvas :ellipse (+ l 32) (- yc 5) (+ l 42) (+ yc 5) (+ seed 3))\n      (. canvas :ellipse (+ l 50) (- yc 5) (+ l 60) (+ yc 5) )+ seed 4)))))"}],"corners":[12,12,12,12],"textEditable":false},{"id":"_-w5CU_WXL8r9FuzD3mrg","type":"Rectangle","parent":"Au31dqi6SwdaH5WP3-6cd","left":105.87,"top":667.58,"width":807.48,"height":29.8,"strokeColor":"$gray6","strokeWidth":2,"strokePattern":[0],"fillColor":"$gray9","fillStyle":"hachure","roughness":1}],"name":"Palette - Most Used","enable":false,"pageOrigin":[164.17741585041884,116],"pageScale":1.1294309489042622}]}