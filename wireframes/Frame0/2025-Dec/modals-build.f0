ght))\n  (def! t (. shape :top))\n  (def! b (. shape :bottom))\n  (def! g 1)\n  (def! seed (. shape :getSeed))\n  (def! c (. shape :corners))\n  (def! h 76)\n  (def! yc (+ t 16))\n  (def! buttons (. shape :getPropertyValue \"Buttons\"))\n  (. canvas :strokeRoundRect (- l g) (- t g) (+ r g) (+ b g) c seed)\n  (if buttons\n    (do \n      (. canvas :ellipse (+ l 14) (- yc 5) (+ l 24) (+ yc 5) (+ seed 2))\n      (. canvas :ellipse (+ l 32) (- yc 5) (+ l 42) (+ yc 5) (+ seed 3))\n      (. canvas :ellipse (+ l 50) (- yc 5) (+ l 60) (+ yc 5) )+ seed 4)))))"}],"corners":[12,12,12,12],"textEditable":false}],"name":"Suite Delete","enable":false,"pageOrigin":[115,170]}]}